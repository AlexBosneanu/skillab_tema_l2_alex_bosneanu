# Copiază acest fișier în `.env` și completează cheia.
#
# Google Gemini (free tier) — ia o cheie gratuită de pe:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# (Opțional) Observability cu LangSmith — decomentează dacă vrei trace-uri.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
# LANGCHAIN_PROJECT=tema-l2-agent
